{
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/schedule",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/inspiration",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
