# Convex deployment URL (written by `npx convex dev` into .env.local)
# Used by the Bun frontend bundle and the seed script.
CONVEX_URL=https://your-deployment.convex.cloud

# HTTP actions site URL from Convex (tracking pixel + click redirects)
CONVEX_SITE_URL=https://your-deployment.convex.site

# Cloud agents only — isolates Convex from your personal deployment
# CONVEX_AGENT_MODE=anonymous

# --- Set these on the Convex deployment (`npx convex env set …`), not in Vercel ---
# ADMIN_SECRET=long-random-string
# RESEND_API_KEY=re_…          # omit for dry-run sends (status still becomes "sent")
# EMAIL_FROM=Cursor Codechella <noreply@cursorvictoria.com>
# SITE_URL=https://your-deployment.convex.site   # optional fallback for tracking base
